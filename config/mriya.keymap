#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick_tap_ms = <200>; };

&mt { quick_tap_ms = <200>; };

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
              &kp ESC               &kp N1  &kp N2    &kp N3            &kp N4                &kp N5    &kp N6  &kp N7                 &kp N8         &kp N9      &kp N0    &kp RIGHT_BRACKET
&kp LEFT_ALT  &kp TAB               &kp Q   &kp W     &kp E             &kp R                 &kp T     &kp Y   &kp U                  &kp I          &kp O       &kp P     &kp LBKT             &kp ENTER
              &mt LEFT_SHIFT GRAVE  &kp A   &kp S     &kp D             &kp F                 &kp G     &kp H   &kp J                  &kp K          &kp L       &kp SEMI  &mt RIGHT_SHIFT SQT
              &kp LSHFT             &kp Z   &kp X     &kp C             &kp V                 &kp B     &kp N   &kp M                  &kp COMMA      &kp DOT     &kp FSLH  &kp RSHIFT
                                            &kp LGUI  &kp LEFT_CONTROL  &mt LEFT_SHIFT SPACE  &mo 1     &mo 2   &mt RIGHT_SHIFT SPACE  &kp BACKSPACE  &kp DELETE
            >;
        };

        lower_layer {
            bindings = <
        &trans    &kp F1             &kp F2  &kp F3      &kp F4   &kp F5        &kp KP_NUM             &kp LESS_THAN    &kp GREATER_THAN  &kp UNDERSCORE   &kp MINUS     &kp EQUAL
&trans  &trans    &kp F6             &kp F7  &kp F8      &kp F9   &kp F10       &kp PIPE               &kp KP_NUMBER_7  &kp KP_NUMBER_8   &kp KP_NUMBER_9  &kp KP_PLUS   &kp KP_MULTIPLY  &trans
        &kp CLCK  &kp K_APPLICATION  &none   &kp LS(F9)  &kp F11  &kp F12       &kp LEFT_PARENTHESIS   &kp KP_NUMBER_4  &kp KP_NUMBER_5   &kp KP_NUMBER_6  &kp KP_MINUS  &kp KP_DIVIDE
        &trans    &none              &none   &none       &none    &kp LC(F1)    &kp RIGHT_PARENTHESIS  &kp KP_NUMBER_1  &kp KP_NUMBER_2   &kp KP_NUMBER_3  &kp KP_DOT    &trans
                                     &mo 3   &trans      &trans   &trans        &kp SPACE              &kp KP_NUMBER_0  &trans            &trans
            >;
        };

        raise_layer {
            bindings = <
        &trans    &trans      &trans  &kp LEFT_BRACE        &kp RIGHT_BRACE        &trans                  &kp PSCRN      &kp SLCK           &kp PAUSE_BREAK  &kp INS    &trans             &trans
&trans  &trans    &kp TILDE   &trans  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp KP_DIVIDE           &kp PAGE_UP    &kp HOME           &kp UP_ARROW     &kp END    &trans             &trans  &trans
        &kp CLCK  &kp TILDE2  &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp NON_US_BACKSLASH    &kp PAGE_DOWN  &kp LEFT           &kp DOWN         &kp RIGHT  &kp K_APPLICATION  &trans
        &trans    &trans      &trans  &kp LESS_THAN         &kp GREATER_THAN       &kp PIPE                &kp C_MUTE     &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &trans     &trans             &trans
                              &trans  &trans                &trans                 &lt 3 RET               &lt 3 ESC      &trans             &trans           &trans
            >;
        };

        adjust_layer {
            bindings = <
       &none        &none         &none         &none         &none         &none           &none         &none         &none         &none         &none         &none
&none  &bootloader  &none         &none         &none         &none         &none           &none         &none         &none         &none         &none         &bootloader  &none
       &bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &bt BT_CLR
       &sys_reset   &none         &none         &none         &none         &none           &none         &none         &none         &none         &none         &sys_reset
                                  &none         &trans        &none         &trans          &trans        &none         &trans        &none
            >;
        };
    };
};
